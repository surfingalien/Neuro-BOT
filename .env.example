DATABASE_URL=file:./db/custom.db

# Dashboard login (HTTP Basic, any username). Required for live trading.
# APP_PASSWORD=

# Coinbase (optional) — balance/holdings + live trading. Use a View+Trade key, never Transfer.
# COINBASE_API_KEY_NAME=organizations/xxx/apiKeys/xxx
# COINBASE_API_PRIVATE_KEY="-----BEGIN EC PRIVATE KEY-----\n...\n-----END EC PRIVATE KEY-----\n"
# LIVE_TRADING_ENABLED=true
# LIVE_BANKROLL_USD=100
# LIVE_MAX_ORDER_USD=25
